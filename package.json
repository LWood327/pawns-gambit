{
  "name": "pawns-gambit",
  "productName": "Pawn's Gambit",
  "version": "1.2.0",
  "description": "A chess app with a live coach, animated board themes and online play with friends.",
  "author": "Logan Woods",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "app": "npm run build && electron .",
    "app:dev": "electron . --dev",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "@fontsource/young-serif": "^5.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "chess.js": "1.4.0",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stockfish": "16.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "com.lwood327.pawnsgambit",
    "productName": "Pawn's Gambit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pawn's Gambit",
      "artifactName": "Pawns-Gambit-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LWood327",
        "repo": "pawns-gambit",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
